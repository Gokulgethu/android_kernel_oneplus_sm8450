# ============================================
# Boot Safety Config Fragment for OnePlus 11R
# Ensures kernel ABI compatibility and safe boot
# ============================================

# Module versioning - allows loading vendor modules
# even with minor kernel symbol differences
CONFIG_MODVERSIONS=y

# Kernel symbol table - required for module loading and debugging
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Embed kernel config in kernel for debugging
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Module support (critical for vendor modules from /vendor partition)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# OverlayFS - required by KernelSU
CONFIG_OVERLAY_FS=y

# Kprobes - used by KernelSU for hooking
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# SELinux (required for Android boot)
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y

# dm-verity (required for verified boot)
CONFIG_DM_VERITY=y

# ext4 (required by KernelSU and Android)
CONFIG_EXT4_FS=y

# Ensure proper initramfs support
CONFIG_BLK_DEV_INITRD=y

# Required for Android boot
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# printk for debugging boot issues
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

# Disable module signature enforcement
# (OPlus vendor modules may not be signed with our key)
CONFIG_MODULE_SIG=n
